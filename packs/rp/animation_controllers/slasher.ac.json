{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.slasher.slasher.fp": {
			"initial_state": "pick",
			"states": {
				"pick": {
					"animations": ["fp.pick"],
					"transitions": [
						{ "idle": "q.all_animations_finished" },
						{ "slash.1": "v.cd_slash_1" },
						{ "slash.2": "v.cd_slash_2" },
						{ "slam.ready": "v.cd_slam_ready" },
						{ "stab.windup": "v.cd_stab_windup" }
					]
				},

				"idle": {
					"animations": ["fp.idle"],
					"transitions": [
						{ "pick": "v.cd_reset" },
						{ "slash.1": "v.cd_slash_1" },
						{ "slash.2": "v.cd_slash_2" },
						{ "slam.ready": "v.cd_slam_ready" },
						{ "stab.windup": "v.cd_stab_windup" }
					]
				},

				"slash.1": {
					"animations": ["fp.slash.1"],
					"on_entry": ["v.slash_anim_update = true;", "v.slash_anim_time = 0;"],
					"on_exit": ["v.slash_anim_update = false;"],
					"transitions": [
						{ "pick": "v.cd_reset || q.state_time >= 0.35" },
						{ "slash.2": "v.cd_slash_2" }
					]
				},

				"slash.2": {
					"animations": ["fp.slash.2"],
					"on_entry": ["v.slash_anim_update = true;", "v.slash_anim_time = 0;"],
					"on_exit": ["v.slash_anim_update = false;"],
					"transitions": [
						{ "pick": "v.cd_reset || q.state_time >= 0.35" },
						{ "slash.1": "v.cd_slash_1" }
					]
				},

				"slam.ready": {
					"animations": ["fp.slam.ready"],
					"transitions": [{ "pick": "v.cd_reset" }, { "slam.clash": "v.cd_slam_clash" }],
					"blend_transition": 0.04
				},

				"slam.clash": {
					"animations": ["fp.slam.clash"],
					"transitions": [{ "pick": "v.cd_reset || q.all_animations_finished" }],
					"blend_transition": 0.15
				},

				"stab.windup": {
					"animations": ["fp.stab.windup"],
					"transitions": [
						{ "pick": "v.cd_reset" },
						{ "stab.thrust": "v.cd_stab_thrust" }
					],
					"blend_transition": 0.03
				},

				"stab.thrust": {
					"animations": ["fp.stab.thrust"],
					"transitions": [
						{ "pick": "v.cd_reset" },
						{ "idle": "q.state_time >= 0.4" },
						{ "stab.windup": "v.cd_stab_windup" }
					],
					"blend_transition": 0.13
				}
			}
		}
	}
}
