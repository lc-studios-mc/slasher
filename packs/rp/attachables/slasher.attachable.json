{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "slasher:slasher",
			"materials": {
				"slasher": "entity_emissive_alpha",
				"fp_arms": "entity_alphatest"
			},
			"textures": {
				"slasher": "textures/slasher/slasher2",
				"fp_arms": "textures/entity/steve"
			},
			"geometry": {
				"slasher.fp": "geometry.slasher.slasher.fp",
				"slasher.tp": "geometry.slasher.slasher.tp",
				"fp_arms": "geometry.slasher.fp_arms"
			},
			"animations": {
				"fp.base": "animation.slasher.slasher.fp.base",
				"fp.hide_test_arms": "animation.slasher.slasher.fp.hide_test_arms",
				"fp.spinning": "animation.slasher.slasher.fp.spinning",
				"fp.pick": "animation.slasher.slasher.fp.pick",
				"fp.idle": "animation.slasher.slasher.fp.idle",
				"fp.slash.1": "animation.slasher.slasher.fp.slash.1",
				"fp.slash.2": "animation.slasher.slasher.fp.slash.2",
				"fp.slam.windup": "animation.slasher.slasher.fp.slam.windup",
				"fp.slam.clash": "animation.slasher.slasher.fp.slam.clash",
				"tp.offset": "animation.slasher.slasher.tp.offset",

				"controller.fp": "controller.animation.slasher.slasher.fp"
			},
			"scripts": {
				"animate": [
					"controller.fp",
					"fp.spinning",
					{ "fp.hide_test_arms": "c.is_first_person" },
					{ "tp.offset": "!c.is_first_person" }
				],
				"initialize": [
					"v.spinning_anim_time = 0;",
					"v.spinning_speed = 0;",
					"v.spinning_speed_next = 0;",
					"v.slash_anim_time = 0;",
					"v.slash_anim_update = false;"
				],
				"pre_animation": [
					"v.cd_reset = q.cooldown_time_remaining('slasher_reset');",
					"v.cd_slash_1 = q.cooldown_time_remaining('slasher_slash_1');",
					"v.cd_slash_2 = q.cooldown_time_remaining('slasher_slash_2');",
					"v.cd_slash_hitstop = q.cooldown_time_remaining('slasher_slash_hitstop');",
					"v.cd_slam_windup = q.cooldown_time_remaining('slasher_slam_windup');",
					"v.cd_slam_clash = q.cooldown_time_remaining('slasher_slam_clash');",

					"v.spinning_speed_lerp_t = math.clamp((v.spinning_speed_next > v.spinning_speed ? 5 : v.spinning_speed > 5 ? 1.8 : 3) * q.delta_time, 0, 1);",
					"v.spinning_speed = math.lerp(v.spinning_speed, v.spinning_speed_next, v.spinning_speed_lerp_t);",
					"v.spinning_anim_time = math.mod(v.spinning_anim_time + v.spinning_speed * q.delta_time, 1);",

					"v.slash_anim_time = v.slash_anim_update ? v.slash_anim_time + (q.delta_time * (v.cd_slash_hitstop ? 0.075 : 1)) : v.slash_anim_time;"
				]
			},
			"render_controllers": [
				{ "controller.render.slasher.slasher.fp": "c.is_first_person" },
				{ "controller.render.slasher.slasher.tp": "!c.is_first_person" },
				{ "controller.render.slasher.fp_arms": "c.is_first_person" }
			]
		}
	}
}
